# Copy to .env for local development. Environment variables override this file.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://pingmessenger:change-me@localhost:5432/pingmessenger?sslmode=disable
# Use a random value of at least 32 bytes; never commit a real secret.
JWT_SIGNING_SECRET=replace-with-a-minimum-32-byte-random-secret
# Generate independently: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
JWT_ISSUER=pingmessenger
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
S3_PUBLIC_BASE_URL=https://assets.example.com
S3_BUCKET=pingmessenger-assets
# Story media is private and served with short-lived presigned GET URLs. Keep
# the bucket's public access blocked; this base is retained for legacy profile
# assets only.
# Keep message documents in a separate bucket from profile and story media.
DOCUMENT_S3_BUCKET=pingmessenger-message-documents
DOCUMENT_MAX_BYTES=104857600
DOCUMENT_MAX_COUNT=20
DOCUMENT_MAX_BYTES_24H=1073741824
DOCUMENT_RETENTION=168h
DOCUMENT_ALLOWED_MIMES=application/pdf,application/rtf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv,application/zip
# Empty for AWS S3; set to the MinIO S3 API endpoint locally.
S3_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379/0
OPENIM_API_BASE_URL=http://localhost:10002
OPENIM_CONVERSATION_GRPC_TARGET=127.0.0.1:10220
OPENIM_WEBHOOK_GRPC_ADDR=:9090
OPENIM_API_TOKEN=replace-with-openim-platform-api-token
# Production: EMAIL_PROVIDER=ses with an SES-verified sender identity. SNS is
# retained only for internal/non-production notification fan-out.
EMAIL_PROVIDER=smtp
AWS_REGION=ap-south-1
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:pingmessenger-verification
AWS_SES_FROM_EMAIL=no-reply@meainternal.com
# Local Kubernetes e2e uses the Mailpit service.
SMTP_ADDRESS=localhost:1025
SMTP_FROM=no-reply@pingmessenger.local
# Optional test-only SMTP mirror for a deployed Mailpit inbox. Keep empty in production.
EMAIL_MIRROR_SMTP_ADDRESS=
EMAIL_MIRROR_FROM=e2e-mirror@pingmessenger.local
# Optional test-only SNS topic mirror for inspectable SMS E2E; keep empty in production.
SMS_MIRROR_TOPIC_ARN=
# HMAC secret for the private PingPay-user -> platform payment event callback.
PINGPAY_EVENT_SECRET=
# Chain transaction indexing. Use a private/provider RPC in production; the
# public devnet endpoint is only a local/test default.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_TIMEOUT=10s
